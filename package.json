{
  "name": "mahatest",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "test": "npm run test --workspace @mahatest/core",
    "dev:admin": "npm run dev --workspace admin",
    "dev:mobile": "npm run start --workspace mobile",
    "dev:api": "npm run start:dev --workspace @mahatest/api",
    "db:push": "npm run db:push --workspace @mahatest/db",
    "db:generate": "npm run generate --workspace @mahatest/db"
  }
}
