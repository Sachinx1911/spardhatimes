datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
  SUPERADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

/// Test कोणत्या प्रकारचा. Learn मधले "मागील वर्षांचे प्रश्न" हे वेगळं
/// साहित्य नसून **testच** आहेत, म्हणून ते `StudyMaterial` मध्ये न ठेवता इथे
/// प्रकार म्हणून आले आहेत — तेच प्रश्न, तेच गुण, तीच निकालाची यंत्रणा.
enum QuizType {
  FULL_LENGTH
  TOPIC_WISE
  PYQ
  CUSTOM
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
}

// How tests inside a series behave once their release time passes.
// RELEASE_ONLY: opens at releaseAt and stays open forever.
// WINDOW: opens at releaseAt and closes at closeAt (no attempts after).
enum TimingMode {
  RELEASE_ONLY
  WINDOW
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  // विद्यार्थी app मध्ये phone + password ने login करतात; admin website वर email ने.
  // म्हणून unique पण nullable — Postgres अनेक NULL चालवून घेतो, त्यामुळे phone
  // नसलेले जुने admin खाती तशीच राहतात, पण दोन विद्यार्थ्यांचा phone एक असू शकत नाही.
  phone         String?        @unique
  passwordHash  String
  role          Role           @default(STUDENT)
  isBlocked     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  attempts      QuizAttempt[]
  bookmarks     Bookmark[]
  articleBookmarks ArticleBookmark[]
  certificates  Certificate[]
  notifications Notification[]
  adminLogs     AdminLog[]
  passwordResetTokens PasswordResetToken[]
  orders        Order[]
  seriesAccess  TestSeriesAccess[]   @relation("StudentAccess")
  grantedAccess TestSeriesAccess[]   @relation("GrantedBy")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 of the raw token; raw value only ever lives in the emailed link
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Category {
  id             String    @id @default(cuid())
  name           String    @unique
  slug           String    @unique
  icon           String?   // URL or icon identifier
  totalTests     Int       @default(0)
  totalQuestions Int       @default(0)
  metaTitle      String?
  metaDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  quizzes        Quiz[]
  testSeries     TestSeries[]
}

/// Dashboard वरच्या सरकत्या पट्टीतल्या जाहिराती.
///
/// प्रतिमा **URL** म्हणून ठेवली आहे, चढवलेली file म्हणून नाही. आजचं
/// `uploadCategoryIcon` फाइल `public/uploads/` मध्ये लिहितं, आणि ते Vercel वर
/// टिकत नाही — तिथली filesystem प्रत्येक deploy ला पुसली जाते. URL ठेवल्याने
/// प्रतिमा कुठेही ठेवता येते आणि तो प्रश्नच येत नाही.
model Banner {
  id         String    @id @default(cuid())
  title      String
  imageUrl   String
  /// दाबल्यावर कुठे न्यायचं. रिकामं = कुठेच नाही, नुसती जाहिरात.
  linkUrl    String?
  active     Boolean   @default(true)
  orderIndex Int       @default(0)
  /// कधीपासून / कधीपर्यंत दाखवायची. दोन्ही null = नेहमी.
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([active, orderIndex])
}

/// विद्यार्थी कोणत्या **परीक्षेची** तयारी करतोय — MPSC, UPSC, SSC, Banking…
///
/// हे `Category` पेक्षा वेगळं आहे आणि तो फरक महत्त्वाचा आहे:
/// Category म्हणजे **विषय** (Mathematics, Current Affairs, History) — म्हणजे
/// आतला मजकूर काय आहे. Exam म्हणजे विद्यार्थी काय **शोधतोय** — दुकान याच्याच
/// आधारे मांडलेलं आहे. एकाच परीक्षेत अनेक विषय येतात, म्हणून दोन्ही लागतात.
model Exam {
  id         String       @id @default(cuid())
  name       String       @unique
  slug       String       @unique
  icon       String?
  orderIndex Int          @default(0)   // दुकानात कोणत्या क्रमाने दाखवायचे
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  testSeries TestSeries[]
  materials  StudyMaterial[]
}

// A Test Series groups several Quizzes (tests) that an admin assigns to
// students. The admin decides up front how many tests it will hold
// (plannedTotalTests) and schedules each test's release. Belongs to a Category.
model TestSeries {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  description String?
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// कोणत्या परीक्षेसाठी. **nullable** — आजच्या series ना exam नाही, त्यांना
  /// तो दिल्यावर पुढे required करता येईल. Exam काढला तर series राहते.
  examId      String?
  exam        Exam?       @relation(fields: [examId], references: [id], onDelete: SetNull)
  timingMode  TimingMode  @default(RELEASE_ONLY)
  plannedTotalTests Int    @default(0)
  published   Boolean     @default(true)

  // विक्री. पैसे **paise मध्ये Int** — Float मध्ये कधीच ठेवायचे नाहीत
  // (₹99.99 चं 99.98999 होतं). Razorpay सुद्धा paise घेतो, म्हणून रूपांतर नाही.
  /// 0 = मोफत. विकायची किंमत.
  priceInPaise Int        @default(0)
  /// छापील किंमत — सवलत दाखवायला. null असेल तर सवलत दाखवायची नाही.
  mrpInPaise   Int?
  /// खरेदीनंतर access किती महिने टिकतो. 0 = कायमस्वरूपी.
  validityMonths Int      @default(12)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  quizzes     Quiz[]
  access      TestSeriesAccess[]
  orders      Order[]

  @@index([categoryId])
  @@index([examId])
}

// Join table: which student can access which test series. Created/removed by
// an admin. assignedById records the granting admin (nullable).
model TestSeriesAccess {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation("StudentAccess", fields: [userId], references: [id], onDelete: Cascade)
  testSeriesId  String
  testSeries    TestSeries @relation(fields: [testSeriesId], references: [id], onDelete: Cascade)
  assignedById  String?
  assignedBy    User?      @relation("GrantedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())

  /// मुदत संपण्याची वेळ. **null = कायमस्वरूपी** — admin ने हाताने दिलेला access
  /// असाच राहतो; विकत घेतलेल्याला series च्या `validityMonths` प्रमाणे मुदत मिळते.
  expiresAt     DateTime?
  /// कोणत्या खरेदीतून आला. null = admin ने दिला. फक्त नोंदीसाठी.
  orderId       String?

  @@unique([userId, testSeriesId])
  @@index([userId])
  @@index([testSeriesId])
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
}

/// पैसे कोणत्या gateway ने घेतले. प्रत्येक order वर नोंदवतो कारण gateway बदलला
/// तरी जुन्या खरेदी कुठून आल्या हे कळलं पाहिजे — परतावा त्याच gateway मधून
/// द्यावा लागतो.
enum PaymentGateway {
  RAZORPAY
  INSTAMOJO
}

/// एक खरेदी. जुळवणी आणि परताव्यासाठी प्रत्येक प्रयत्नाची नोंद राहते —
/// अयशस्वी झालेलेही, कारण "पैसे गेले पण access मिळाला नाही" अशा तक्रारीत
/// तीच नोंद उपयोगी पडते.
model Order {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  testSeriesId      String
  testSeries        TestSeries  @relation(fields: [testSeriesId], references: [id], onDelete: Cascade)

  /// किंमत खरेदीच्या वेळची — पुढे series ची किंमत बदलली तरी जुनी नोंद बदलत नाही.
  amountInPaise     Int
  status            OrderStatus    @default(CREATED)

  // Gateway ची नावं मुद्दाम निरपेक्ष आहेत. Razorpay आणि Instamojo दोन्ही
  // चालावेत असं ठरलं आहे, म्हणून `razorpayOrderId` सारखं नाव ठेवलं असतं तर
  // दुसरा gateway जोडताना ते खोटं ठरलं असतं.
  gateway           PaymentGateway
  /// Gateway ने दिलेला order/payment-request चा id.
  gatewayOrderId    String         @unique
  /// पैसे भरल्यावर gateway देतो तो id. भरेपर्यंत null.
  gatewayPaymentId  String?

  createdAt         DateTime       @default(now())
  paidAt            DateTime?

  @@index([userId])
  @@index([testSeriesId])
}

model Quiz {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  description    String?
  duration       Int            // in minutes
  marks          Float          // total marks
  negativeMarks  Float          @default(0.0)
  passingMarks   Float
  difficulty     Difficulty     @default(MEDIUM)
  type           QuizType       @default(FULL_LENGTH)
  status         QuizStatus     @default(DRAFT)
  instructions   String?
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Test-series linkage + scheduling. A quiz may belong to one series (or be a
  // standalone quiz when null). releaseAt = when students can see/attempt it;
  // closeAt = when it locks again (only used when the series is WINDOW mode).
  testSeriesId   String?
  testSeries     TestSeries?    @relation(fields: [testSeriesId], references: [id], onDelete: SetNull)
  orderIndex     Int            @default(0)
  releaseAt      DateTime?
  closeAt        DateTime?
  releaseNotified Boolean       @default(false) // set once release notifications have been fanned out
  isPublic       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  questions      Question[]
  attempts       QuizAttempt[]
  bookmarks      Bookmark[]
  certificates   Certificate[]

  @@index([testSeriesId])
}

// Result आणि Analytics मधली "Section / Subject Wise Performance" याच्यावर उभी आहे.
//
// हे मुद्दाम वेगळं model आहे, Question वरचं मोकळं text नाही. आजचा `categoryName`
// (topic) मोकळं text आहे आणि त्याचा परिणाम दिसतो — "Banking", "Banking Services",
// "Banking Reforms", "Rural Banking" असे एकाच विषयाचे चार तुकडे पडले आहेत.
// विषयाचं नाव बदलायचं असेल तर इथे एक ओळ बदलते, हजारो प्रश्न नाही.
model Subject {
  id         String     @id @default(cuid())
  name       String     @unique
  slug       String     @unique
  orderIndex Int        @default(0)   // Result मध्ये कोणत्या क्रमाने दाखवायचे
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  questions  Question[]
  materials  StudyMaterial[]
}

model Question {
  id            String         @id @default(cuid())
  quizId        String
  quiz          Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type          QuestionType   @default(SINGLE_CHOICE)
  text          String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String         // SINGLE_CHOICE/TRUE_FALSE: "A".."D"; MULTIPLE_CHOICE: sorted comma list e.g. "A,C"
  explanation   String?
  difficulty    Difficulty     @default(MEDIUM)
  marks         Float          @default(1.0)
  // विषय — Result/Analytics चे ठोक गट. Nullable, म्हणजे आधीच भरलेले प्रश्न तसेच
  // चालू राहतात; त्यांना विषय नंतर देता येईल.
  subjectId     String?
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  // विषयाच्या आतला बारीक topic ("Rural Banking"). हे मोकळं text आहे आणि तसंच
  // ठेवलं आहे — इथे थोडी विसंगती चालते, कारण यावर कुठलाही अहवाल उभा नाही.
  categoryName  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  responses     QuestionResponse[]
  bookmarks     Bookmark[]

  @@index([subjectId])
}

model QuizAttempt {
  id               String             @id @default(cuid())
  userId           String?
  user             User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId          String?
  quizId           String
  quiz             Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score            Float              @default(0.0)
  percentage       Float              @default(0.0)
  correctAnswers   Int                @default(0)
  wrongAnswers     Int                @default(0)
  skippedQuestions Int                @default(0)
  timeTaken        Int                @default(0) // in seconds
  rank             Int?
  percentile       Float?
  status           AttemptStatus      @default(IN_PROGRESS)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  responses        QuestionResponse[]

  @@index([userId])
  @@index([quizId])
}

model QuestionResponse {
  id           String      @id @default(cuid())
  attemptId    String
  attempt      QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chosenOption String?     // "A", "B", "C", "D"
  isCorrect    Boolean     @default(false)
  timeSpent    Int         @default(0) // in seconds
  createdAt    DateTime    @default(now())

  @@unique([attemptId, questionId])
}

model Bookmark {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId     String
  quiz       Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId String
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([userId, questionId])
}

model Certificate {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId          String
  quiz            Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  certificateCode String   @unique
  issueDate       DateTime @default(now())
  downloadUrl     String?

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  type      String   @default("info") // e.g. "test_completed", "quiz_published", "certificate_generated"
  createdAt DateTime @default(now())

  @@index([userId])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId])
}

/// जाहिरातींची पट्टी.
///
/// ⚠️ **हा model database मध्ये आधीच होता, schema मध्ये नव्हता.** 2026-07-31 ला
/// `prisma migrate diff` ने दाखवलं की `db push` त्याला `DROP TABLE` करणार आहे —
/// म्हणजे त्यातली जाहिरात नष्ट. म्हणून तो जसा आहे तसा इथे नोंदवला आहे: columns,
/// nullability, defaults आणि index सगळं database मधून तंतोतंत घेतलं.
///
/// यातून धडा असा: `main` आणि ही branch **एकाच** Supabase वर आहेत पण त्यांची
/// schema वेगळी. एका branch मधून `db push` केलं की दुसऱ्या branch ची tables उडतात.
/// नवीन table कुठे बनवलं तरी ते **दोन्ही** schema मध्ये नोंदवा, नाहीतर पुढच्या
/// push ला तेच पुन्हा होईल.

// ─── अभ्यास साहित्य ───────────────────────────────────────────────────────────
//
// Learn tab मधलं सगळं. लेखांप्रमाणेच इथेही **URL** ठेवली आहे, चढवलेली file
// नाही: R2 सारखं storage अजून जोडलेलं नाही, आणि URL ठेवल्याने ते येईपर्यंत
// काम अडत नाही — Drive/YouTube चा दुवा आजही चालतो. Storage आल्यावर फक्त
// admin मधला upload मार्ग बदलेल, हे model तसंच राहील.

enum StudyMaterialType {
  NOTE
  VIDEO
  BOOK
  SHORT
}

model StudyMaterial {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  description String?
  type        StudyMaterialType

  /// फाइल / व्हिडिओचा दुवा. PDF, YouTube, काहीही.
  url         String
  /// यादीत दाखवायचं चित्र. नसेल तर app प्रकारानुसार चिन्ह वापरतो.
  thumbnailUrl String?

  /// विषय आणि परीक्षा — दोन्ही आधीच्याच models, नवीन गट बनवलेले नाहीत.
  /// Nullable, कारण एखादं साहित्य सर्वसाधारण असू शकतं.
  /// विषय काढला तरी साहित्य राहावं म्हणून `SetNull` (`Article` सारखं
  /// `Restrict` नाही — तिथे गट अनिवार्य आहे, इथे नाही).
  subjectId   String?
  subject     Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  examId      String?
  exam        Exam?             @relation(fields: [examId], references: [id], onDelete: SetNull)

  /// व्हिडिओची लांबी (सेकंद) / टिपणीची पानं. ज्याला लागू नाही तिथे null.
  durationSeconds Int?
  pageCount   Int?

  published   Boolean           @default(false)
  /// यादीचा क्रम याच्यावरून — जुनं साहित्य नंतर प्रकाशित केलं तरी वर यावं.
  publishedAt DateTime?
  orderIndex  Int               @default(0)

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([published, type, publishedAt])
  @@index([subjectId])
  @@index([examId])
}

// ─── चालू घडामोडी ──────────────────────────────────────────────────────────────
//
// हे quiz-आधारित models पासून मुद्दाम वेगळे आहेत. `Category` आणि `Subject` हे
// प्रश्नांचे गट आहेत आणि त्यांच्यावर `totalTests` / `orderIndex` सारखी quiz ची
// fields आहेत — तिथे लेखांचे गट कोंबले असते तर दोन्हीचे अर्थ गढूळ झाले असते.

/// लेखांचे गट — "राष्ट्रीय", "आंतरराष्ट्रीय", "अर्थव्यवस्था"…
model ArticleCategory {
  id         String    @id @default(cuid())
  /// मराठी नाव — cards वरचा tag आणि खालची वर्तुळं यात हेच दिसतं.
  name       String    @unique
  /// इंग्रजी नाव — वरचे chips design मध्ये इंग्रजीत आहेत ("Science & Tech").
  /// Nullable, म्हणजे admin ने न दिलं तरी चालतं; app तेव्हा मराठी नाव वापरतो.
  /// slug वरून काढता येत नाही — "science-tech" चं "Science & Tech" होत नाही.
  nameEn     String?
  slug       String    @unique
  /// Ionicons चं नाव, admin ठरवतो — `Exam.icon` सारखंच.
  icon       String?
  /// Chip आणि गोल चिन्हाचा रंग (hex). null असेल तर app ठरलेला रंग वापरतो,
  /// म्हणजे admin ने रंग न दिला तरी पडदा बिघडत नाही.
  color      String?
  orderIndex Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  articles   Article[]
}

model Article {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  /// यादीत दिसणारा दोन ओळींचा सारांश. नसेल तर app `body` ची सुरुवात वापरतो.
  excerpt     String?
  body        String
  /// थंबनेल / hero चित्र. फाइल upload ऐवजी URL — admin कडे आधीच
  /// `/public/uploads/` आहे आणि तिथला पत्ता इथे टाकता येतो; बाहेरचाही चालतो.
  imageUrl    String?
  categoryId  String
  /// गट काढून टाकला तर त्याखालचे लेख आपोआप जाऊ नयेत — म्हणून `Restrict`.
  /// (`Cascade` असतं तर एक चूक शंभर लेख घेऊन गेली असती.)
  category    ArticleCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// `TestSeries` सारखंच boolean — नवीन enum जोडण्याची गरज नाही.
  published   Boolean           @default(false)
  /// कधी प्रकाशित झाला. यादीचा क्रम याच्यावरून, `createdAt` वरून नाही — जुना
  /// लेख नंतर प्रकाशित केला तर तो वरतीच यायला हवा.
  publishedAt DateTime?
  /// वरच्या carousel मध्ये दाखवायचा का ("Top News").
  isTopNews   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  bookmarks   ArticleBookmark[]

  // यादी नेहमी "प्रकाशित, नवीन आधी" अशी मागवली जाते.
  @@index([published, publishedAt])
  @@index([categoryId])
}

/// लेखाची खूण.
///
/// `Bookmark` मध्ये कोंबलेली नाही — तिथे `questionId` आणि `quizId` सक्तीचे आहेत
/// आणि `@@unique([userId, questionId])` आहे. लेखासाठी ती nullable केली असती तर
/// तो unique नियम मोडला असता आणि "सोडवलेला प्रश्न असेल तरच" ही तपासणीही गोंधळली
/// असती. वेगळं table स्वस्त आहे.
model ArticleBookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
  @@index([articleId])
}
